# Keep the build context small and reproducible.
# NOTE: @data/** is intentionally NOT ignored — the prebuild feed scripts read
# @data/history and @data/*.json to regenerate public/history & the indexes.

node_modules
.next
out
.git
.github
.vscode
.idea

# Regenerated by `npm run prebuild` (scripts/build-public-feeds.mjs)
public/history
public/message-paths.json

# Local secrets / config that must never enter an image
@build/config-m365.json
@build/secrets-m365.json
*.env
*.log
.DS_Store
.eslintcache
*.tsbuildinfo
